# =============================================================================
# Application
# =============================================================================
# One binary per surface: APP_PORT is the public (site-facing) API,
# APP_ADMIN_PORT is the admin (authoring) API.
APP_PORT=8080
APP_ADMIN_PORT=8081

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=barbara
APP_DB_USER=barbara
APP_DB_PASSWORD=barbara
APP_DB_SSLMODE=disable

# =============================================================================
# Cache (Redis)
# =============================================================================
APP_REDIS_ADDR=localhost:6379

# =============================================================================
# Search (OpenSearch) — the serving store for site-facing reads
# =============================================================================
APP_OPENSEARCH_ADDR=http://localhost:9200
APP_OPENSEARCH_USERNAME=
APP_OPENSEARCH_PASSWORD=

# =============================================================================
# Storage (MinIO/S3)
# =============================================================================
APP_STORAGE_ENDPOINT=localhost:9000
APP_STORAGE_ACCESS_KEY=barbara
APP_STORAGE_SECRET_KEY=barbaradev
APP_STORAGE_BUCKET=barbara
APP_STORAGE_USE_SSL=false

# =============================================================================
# Security
# =============================================================================
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# Mesh (janus/aegis) — identity/entitlement over the service mesh
# =============================================================================
# Where barbara dials janus/aegis.
APP_MESH_ADDR=localhost:9443
# TLS is off by default for local dev (insecure gRPC). Enable for server-only
# TLS (CA cert alone) or mutual TLS (CA cert + client cert/key).
APP_GRPC_TLS_ENABLED=false
APP_GRPC_TLS_CA_CERT=
APP_GRPC_TLS_CERT_FILE=
APP_GRPC_TLS_KEY_FILE=

# =============================================================================
# Observability (OTEL)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=barbara-api
